{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SVN Packager",
  "version": "2.0.0",
  "identifier": "com.svnpackager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "SVN Packager",
		"width": 1280,
		"height": 800,
		"minWidth": 850,
		"minHeight": 550,
		"resizable": true,
		"fullscreen": false,
		"center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capabilities",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "shell:allow-open",
            "dialog:allow-open",
            "dialog:allow-save",
            "dialog:allow-ask"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}